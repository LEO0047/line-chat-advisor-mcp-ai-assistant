{
  "name": "line-context-relay",
  "version": "0.2.0",
  "description": "Local-first, read-only LINE conversation advice for ChatGPT/Codex on macOS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LEO0047/line-chat-advisor-mcp-ai-assistant.git"
  },
  "type": "module",
  "scripts": {
    "start": "node src/line-readonly-mcp/server.mjs",
    "test": "node --test tests/*.test.mjs && .venv/bin/python3 -m unittest discover -s tests -p 'test_*.py'",
    "doctor": "scripts/doctor",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm test && npm run check:package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "3.25.76"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "homepage": "https://github.com/LEO0047/line-chat-advisor-mcp-ai-assistant#readme",
  "bugs": {
    "url": "https://github.com/LEO0047/line-chat-advisor-mcp-ai-assistant/issues"
  },
  "files": [
    "src/line-readonly-mcp/*.mjs",
    "src/line-readonly-mcp/*.py",
    "src/key-capture/*.py",
    "src/key-capture/*.swift",
    "src/key-capture/*.plist",
    "scripts/*",
    "skills/line-chat-advisor/SKILL.md",
    "tests/*.mjs",
    "tests/*.py",
    "requirements.lock",
    "LICENSE",
    "bin/*.mjs",
    "npm-shrinkwrap.json",
    "README.md",
    "INSTALL.md",
    "MAINTAINERS.md",
    "SECURITY.md",
    "PRIVACY.md",
    "AUDIT.md",
    "VENDOR_LOCK.md",
    "ACCEPTANCE.md",
    "requirements-attachments.in",
    "requirements-attachments.lock",
    "src/line-readonly-mcp/*.swift",
    "skills/line-chat-advisor/references/*.md",
    "HISTORY-UI-TROUBLESHOOTING.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "line-context-relay": "bin/line-context-relay.mjs"
  }
}
